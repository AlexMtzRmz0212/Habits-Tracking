# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored — never commit it, and never paste these values into a
# chat or an issue. Every script here reads them from the environment, so the
# secrets only ever live on your machine and in Vercel/GitHub settings.

# ---------------------------------------------------------------------------
# POOLED vs DIRECT — Neon gives you two connection strings, and which one you
# want depends on where the code runs:
#
#   DIRECT (pooling toggle OFF, host has no "-pooler")
#     -> use HERE, and in GitHub Actions.
#     Migrations and DDL need session-level features that Neon's pooler runs in
#     transaction mode and therefore drops. The pipeline is also one long-lived
#     connection doing batch upserts, which is what a direct connection is for.
#
#   POOLED (pooling toggle ON, host contains "-pooler")
#     -> use in VERCEL only.
#     Serverless functions open many short-lived connections and would exhaust
#     the direct connection limit.
#
# Same variable names in both places, environment-appropriate values.
# ---------------------------------------------------------------------------

# Neon Postgres — full access. Used by the pipeline, the migrations, and the
# web app's private (PIN-gated) data path.
# Dashboard -> Connection string -> URI format, pooling OFF for local/CI.
# postgresql://neondb_owner:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_PRIVATE=

# Same database, but connecting as the habits_public_ro role created by
# db/roles.sql. That role can only read the is_public views, so the public
# pages physically cannot query a private habit.
# Build it by swapping the user and password in the URL above.
# Not needed until Phase 5 (the web app).
DATABASE_URL_PUBLIC=

# ---------------------------------------------------------------------------
# Google Drive sync (Phase 3). Not needed yet.
# GOOGLE_SERVICE_ACCOUNT_JSON is the whole service-account key file, base64'd.
# GOOGLE_DRIVE_FOLDER_ID is the id in the Drive folder's URL.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Web app (Phase 5). The PIN that reveals your private habits.
# Use something long; it is the only thing standing between a visitor and your
# full habit history.
# ---------------------------------------------------------------------------
PRIVATE_ACCESS_PIN=
SESSION_SECRET=
